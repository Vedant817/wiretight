# Wiretight local sandbox configuration. Placeholders only; never commit real keys.
# Copy to .env. API credentials belong to the worker, never the web process.
AWX_ENV=sandbox
AWX_BASE_URL=https://api.sandbox.airwallex.com
AWX_MODE=live
AWX_CLIENT_ID=your-sandbox-client-id
AWX_API_KEY=your-sandbox-api-key
# Optional account selection and non-FX version header.
AWX_LOGIN_AS=
AWX_API_VERSION=
AWX_HTTP_TIMEOUT_S=20

APP_DB_PATH=var/app.sqlite
APP_POLICY_PATH=policy.yaml
APP_KEY_DIR=var/keys
APP_HALT_FILE=var/HALT
APP_AUDIT_CHECKPOINT_DIR=var/audit-checkpoints

# Passkey RP/origin must match the browser URL. HTTPS outside localhost.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8000
SIGNING_MODE=webauthn

# Optional: set the signing secret from the actual Airwallex webhook subscription.
AWX_WEBHOOK_SECRET=

# No demo/replay seed, simulated funding, shortened cooling or test signer setting.
# Business legal name, operator roster and USD reserve are explicit setup inputs.
