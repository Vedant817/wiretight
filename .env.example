# Wiretight — environment template.  FINAL.md §6.3.
#
# PLACEHOLDERS ONLY. Never put a real key in this file; it is committed.
# Copy to .env and fill in. .env is git-ignored.
#
#   copy .env.example .env
#
# The web process reads only LLM_*; the worker reads only AWX_*.
# Each refuses to start if it can see the other's secret (§5.3).

# --- Airwallex (worker process only) ---------------------------------------
# AWX_ENV must be exactly "sandbox". Anything else exits non-zero (T-09b).
AWX_ENV=sandbox

# Exact-match allowlist. Anything else exits non-zero (T-09a).
# FINAL.md §6.3: no production URL exists anywhere in this project.
AWX_BASE_URL=https://api.sandbox.airwallex.com

# Paste your sandbox keys here. NEVER into chat, an issue, a commit or a fixture.
# Business name must be exactly "Sandbox Business" or "New Business Sandbox".
AWX_CLIENT_ID=
AWX_API_KEY=

# Optional x-login-as header.
AWX_LOGIN_AS=

# If set, sent as x-api-version on NON-/fx/ paths only. Leave empty by default.
AWX_API_VERSION=

# Startup check against the version recorded by the day-1 spike (U6).
AWX_MIN_ACCOUNT_API_VERSION=2025-06-30

# replay (tests/CI, no network) | live | record
AWX_MODE=replay

AWX_FIXTURES_DIR=tests/fixtures/airwallex

# uuid5 namespace for request_id (§7.3). Generate one per install; see `make keys`.
AWX_REQUEST_ID_NAMESPACE=

# Guide rate limits.
AWX_RPS_GLOBAL=20
AWX_RPS_PER_ENDPOINT=10
AWX_MAX_CONCURRENCY=10

# Timeout on a MUTATING call becomes AMBIGUOUS.
AWX_HTTP_TIMEOUT_S=20

# --- Application ----------------------------------------------------------
APP_DB_PATH=var/app.sqlite
APP_POLICY_PATH=policy.example.yaml
APP_POLICY_SIG_PATH=var/policy.sig.json

# Either a HALT here, or an unreadable path, means halted. Fail closed (§4.9).
APP_HALT_FILE=var/HALT

APP_AUDIT_CHECKPOINT_DIR=var/audit-checkpoints
APP_AUDIT_SIGNING_KEY_PATH=var/keys/audit_ed25519.pem

# Daily caps use the IST calendar day.
APP_DISPLAY_TZ=Asia/Kolkata

# true shortens COOLING-OFF ONLY (72 h -> 2 min), and only when AWX_ENV=sandbox
# AND the host pin passes AND the loaded policy sets demo_timing: true.
# FINAL is never shortened. Every affected screen shows "demo timing · policy 72 h".
APP_DEMO_TIMING=false

APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- Signing --------------------------------------------------------------
# webauthn | hmac_fallback   ("FALLBACK (HMAC, not phishing-resistant)")
SIGNING_MODE=webauthn

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Wiretight (demo)
WEBAUTHN_ORIGIN=http://localhost:8000

# Fallback only; generated by `make keys`, never committed.
APPROVER_HMAC_KEYS_PATH=var/keys/approvers.json

# --- Polling --------------------------------------------------------------
POLL_INTERVAL_S=2
POLL_MAX_INTERVAL_S=60

# --- Optional features (all off by default, fail closed) ------------------
WEBHOOKS_ENABLED=false
AWX_WEBHOOK_SECRET=
WEBHOOK_TOLERANCE_SECONDS=300

# Verification of Payee: evidence only. Never lowers a tier, never removes a callback.
VERIFY_ACCOUNT_ENABLED=false

# Runs the whole loop but the client's mutating methods raise ShadowModeViolation.
SHADOW_MODE=false

# --- LLM (web process only; NEVER in the money path) ----------------------
LLM_ENABLED=false
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model id is recorded in eval run_meta.json, never hard-coded.
LLM_MODEL=